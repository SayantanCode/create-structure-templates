// Add your own models here — or pick a module (like Auth) that ships its
// own schema.prisma and depends on this one, which will overwrite this
// bare file with a fuller one that already includes a model.
//
// After changing this file:
//   npx prisma generate               # regenerate the typed client
//   npx prisma db push                # apply the schema to your database (dev)
//   npx prisma migrate dev --name X   # or use real migrations instead of db push

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
